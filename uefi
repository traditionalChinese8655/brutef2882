    li a7, 4
    ecall
    li a7, 8
    la a0, a8
    li a1, 2
    ecall
    j choice_end
set9:
    la a0, prompt2
    li a7, 4
    ecall
    li a7, 8
    la a0, a9
    li a1, 2
    ecall
    j choice_end

choice_end:
    ret

exit:
    li a7, 10
    ecall

main:
    loop:
        jal board
        jal choice
        j loop
